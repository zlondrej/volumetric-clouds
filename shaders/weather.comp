#version 430

// Generates a tileable 2D "weather" texture: large scale cloud coverage.
// Many octaves give clusters of varying size instead of evenly spaced blobs,
// and the texture covers a large area so its repetition isn't visible.

#include "noise-functions.glsl"

layout (local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

writeonly layout(r8) uniform image2D weatherIm;

void main() {
    ivec2 size = imageSize(weatherIm);
    ivec2 id = ivec2(gl_GlobalInvocationID.xy);

    if (any(greaterThanEqual(id, size))) {
        return;
    }

    vec2 uv = (vec2(id) + 0.5) / vec2(size);

    // z is off the lattice planes, where Perlin noise has less variation.
    float v = perlinFbm(vec3(uv, 0.37), 8.0, 6);

    imageStore(weatherIm, id, vec4(v));
}
