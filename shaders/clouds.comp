#version 430

#include "common.glsl"

layout (local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

uniform sampler2D depthTex;                    // full resolution scene distance
writeonly layout(rgba16f) uniform image2D cloudIm;   // rgb = in-scattered light, a = 1 - transmittance
writeonly layout(r32f) uniform image2D cloudDepthIm; // scene distance the ray was marched against

uniform vec3 eyePosition;
uniform mat4 invVP;

const float maxDistance = 9000.0;
const int maxSteps = 100;
const int minSteps = 24;
const float extinction = 0.09;     // per world unit at density 1
const float lightAbsorption = 1.0;  // >1 makes self-shadowing stronger
const float densityScale = 5.0;
const float pixelAngle = 0.0035;   // approximate angular size of a low-res pixel

float interleavedGradientNoise(vec2 p) {
    return fract(52.9829189 * fract(dot(p, vec2(0.06711056, 0.00583715))));
}

float henyeyGreenstein(float cosTheta, float g) {
    float g2 = g * g;
    return (1.0 - g2) / (4.0 * PI * pow(1.0 + g2 - 2.0 * g * cosTheta, 1.5));
}

/** Optical depth towards the sun. */
float lightMarch(vec3 p, float footprint) {
    const int lightSteps = 5;
    float h = (p.y - cloudBottom) / cloudThickness;
    // Distance to the top of the layer along the sun direction, limited.
    float dist = min((cloudTop - p.y) / max(sunDirection.y, 0.05), cloudThickness * 1.2);
    float od = 0.0;
    float t = 0.0;
    float ds = dist / 15.0;   // geometric progression 1,2,3,4,5 -> sums to 15
    for (int i = 0; i < lightSteps; i++) {
        float stepLen = ds * float(i + 1);
        t += stepLen * 0.5;
        vec3 lp = p + sunDirection * t;
        od += cloudDensity(lp, max(footprint, stepLen * 0.25), i < 2) * stepLen;
        t += stepLen * 0.5;
    }
    return od * densityScale * extinction * lightAbsorption;
}

/** Returns vec2(tNear, tFar) of the ray segment inside the cloud slab. */
vec2 slabIntersect(vec3 ro, vec3 rd) {
    if (abs(rd.y) < 1e-5) {
        if (ro.y > cloudBottom && ro.y < cloudTop) {
            return vec2(0.0, maxDistance);
        }
        return vec2(-1.0);
    }
    float t0 = (cloudBottom - ro.y) / rd.y;
    float t1 = (cloudTop - ro.y) / rd.y;
    float tn = max(min(t0, t1), 0.0);
    float tf = max(t0, t1);
    return vec2(tn, tf);
}

void main() {
    ivec2 id = ivec2(gl_GlobalInvocationID.xy);
    ivec2 cloudSize = imageSize(cloudIm);

    if (id.x >= cloudSize.x || id.y >= cloudSize.y) {
        return;
    }

    ivec2 screenSize = textureSize(depthTex, 0);
    ivec2 scale = (screenSize + cloudSize - 1) / cloudSize;
    ivec2 fullCoords = min(id * scale + scale / 2, screenSize - 1);

    float sceneDepth = texelFetch(depthTex, fullCoords, 0).r;

    vec2 ndc = (vec2(fullCoords) + 0.5) / vec2(screenSize) * 2.0 - 1.0;
    vec4 nearPoint = invVP * vec4(ndc, -1.0, 1.0);
    vec3 rd = normalize(nearPoint.xyz / nearPoint.w);
    vec3 ro = eyePosition;

    vec2 seg = slabIntersect(ro, rd);
    float tStart = seg.x;
    float tEnd = min(min(seg.y, sceneDepth), maxDistance);

    vec3 scattered = vec3(0.0);
    float transmittance = 1.0;

    if (tEnd > tStart) {
        float len = tEnd - tStart;
        int steps = int(clamp(len / 3.0, float(minSteps), float(maxSteps)));

        // Samples are distributed logarithmically: dense near the camera,
        // sparse far away. With uniform steps, long (near horizontal) rays
        // got very coarse steps even close to the camera, which made nearby
        // clouds disappear in a horizontal band.
        const float logOffset = 20.0;
        float sStart = tStart + logOffset;
        float k = log((tEnd + logOffset) / sStart) / float(steps);
        float stepGrowth = exp(k) - 1.0;

        float cosTheta = dot(rd, sunDirection);
        // Dual-lobe phase function: strong forward scattering (silver lining) + some back scatter.
        float phase = mix(henyeyGreenstein(cosTheta, 0.65), henyeyGreenstein(cosTheta, -0.2), 0.45);
        phase = phase * 4.0 * PI * 0.8 + 0.1;

        // Static per-pixel jitter hides banding from the step size. (Animating it
        // would need temporal accumulation, otherwise it flickers.)
        float jitter = interleavedGradientNoise(vec2(id));

        float weightedDepth = 0.0;
        float weightSum = 0.0;

        for (int i = 0; i < steps; i++) {
            float s = sStart * exp(k * (float(i) + jitter));
            float t = s - logOffset;
            float stepSize = s * stepGrowth;

            vec3 p = ro + rd * t;
            // Texture LOD follows the pixel size. Basing it on the step size
            // blurs the noise so much that clouds fall under the coverage
            // threshold and vanish.
            float footprint = max(t * pixelAngle, stepSize * 0.25);
            float density = cloudDensity(p, footprint, true);

            if (density > 0.003) {
                float sigma = density * densityScale * extinction;
                float h = (p.y - cloudBottom) / cloudThickness;

                float lightOD = lightMarch(p, footprint);

                // Approximate multiple scattering with a few octaves (Wrenninge et al.).
                vec3 sunLight = vec3(0.0);
                float a = 1.0, b = 1.0;
                for (int o = 0; o < 3; o++) {
                    sunLight += a * exp(-lightOD * b) * phase;
                    a *= 0.5;
                    b *= 0.5;
                }
                // "Powder" effect darkens edges facing the viewer.
                float powder = 1.0 - exp(-sigma * 40.0);
                sunLight *= sunColor * mix(1.0, powder, 0.5);

                vec3 ambient = ambientColor(h) * (0.12 + 0.4 * h);

                float stepTransmittance = exp(-sigma * stepSize);
                vec3 light = sunLight + ambient;
                scattered += transmittance * light * (1.0 - stepTransmittance);

                float w = transmittance * (1.0 - stepTransmittance);
                weightedDepth += t * w;
                weightSum += w;

                transmittance *= stepTransmittance;
                if (transmittance < 0.01) {
                    break;
                }
            }
        }

        // Aerial perspective: far clouds fade into the sky.
        float cloudDist = weightSum > 0.0 ? weightedDepth / weightSum : tEnd;
        float fog = exp(-cloudDist / hazeDistance);
        vec3 sky = skyColor(rd);
        scattered = mix(sky * (1.0 - transmittance), scattered, fog);
    }

    imageStore(cloudIm, id, vec4(scattered, 1.0 - transmittance));
    imageStore(cloudDepthIm, id, vec4(sceneDepth));
}
